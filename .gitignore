# ==========================================================================
#  RPA CoE Control Room — Root .gitignore
#  ⚠️ NEVER commit secrets, agent credentials, or database backups here.
# ==========================================================================

# ---------- Secrets & credentials (CRITICAL) ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
agent_credentials.json
enroll_config.json
secrets.toml
*.secret

# ---------- Database dumps & backups (never in Git) ----------
*.bak
*.bkp
*.bacpac
*.dacpac
*.trn
*.mdf
*.ldf
*.sql.gz
/backups/

# ---------- Logs ----------
*.log
logs/
api.log
agent.log

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/
dist/
build/
.tox/

# ---------- Node / Vite ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- IDE / OS ----------
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# ---------- Test / E2E artifacts ----------
playwright-report/
test-results/
blob-report/
playwright/.cache/

# ---------- Runtime data ----------
/data/
/tmp/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
# The development SQLite database is named after DB_NAME ("RPA_Dashboard") with
# no extension, so the patterns above never catch it — running the README's
# `DB_DIALECT=sqlite ... python -m app.main` drops these at the repository root.
/RPA_Dashboard
/RPA_Dashboard-shm
/RPA_Dashboard-wal
