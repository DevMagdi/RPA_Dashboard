# ==========================================================================
#  RPA CoE Control Room — Environment template (all 80 settings, verified
#  against app/core/config.py::Settings by tests/test_config.py)
#  Copy to `.env` for local dev:  cp .env.example .env
#  In production DO NOT use a .env file: inject real secrets through
#  Azure Key Vault / HashiCorp Vault (see SECRET_BACKEND below).
# ==========================================================================

# ---------- Runtime / platform ----------
ENV=dev                              # dev | test | prod  (prod enforces strict security)
APP_NAME=RPA CoE Control Room
APP_VERSION=4.0.0
LOG_LEVEL=INFO
LOG_JSON=false                       # true in prod for structured JSON logs

# ---------- Network / hosting ----------
# Comma separated. In prod: your real hostnames, e.g. coe.bank.local,10.20.30.40
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_PROXIES=127.0.0.1            # reverse proxy IPs whose X-Forwarded-* we trust
IP_ALLOWLIST=                        # optional: 10.0.0.0/8,192.168.1.15  (empty = allow all)

# ---------- Database ----------
DB_DIALECT=mssql                     # mssql | postgresql | sqlite  (zero-code switch)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=RPA_Dashboard
DB_USER=sa
DB_PASSWORD=ChangeMe_Strong1!
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERT=yes             # set to no in prod with a valid certificate
DB_CONNECT_TIMEOUT=30
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=30000

# ---------- Security / crypto ----------
# Generate once:  python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace_me_with_a_long_random_value_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=15       # short-lived access token (bank-grade)
REFRESH_TOKEN_EXPIRE_DAYS=7
# Generate once:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=                          # MANDATORY in prod (credential vault key)
AGENT_TOKEN_PEPPER=                  # pepper for hashing agent tokens
ENROLLMENT_TTL_MINUTES=15
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
COOKIE_SECURE=false                  # true in prod (HTTPS only)
COOKIE_DOMAIN=                       # optional: .bank.local (empty = host-only cookie)
CSRF_ENABLED=true
# Path prefixes (refresh-cookie auth) that require the double-submit CSRF header:
CSRF_PROTECTED_PATHS=/api/auth/refresh,/api/auth/logout,/api/auth/sessions,/api/auth/change-password
HSTS_MAX_AGE=31536000

# ---------- MFA ----------
MFA_ENABLED=true
MFA_ISSUER=RPA CoE Control Room
MFA_WINDOW=1                         # TOTP clock-drift window (steps of 30s)
MFA_BACKUP_CODES=10

# ---------- Secret backend (bank secret manager) ----------
# env | azure_keyvault | hashicorp_vault
SECRET_BACKEND=env
AZURE_KEYVAULT_URL=
AZURE_KEYVAULT_PREFIX=rpa-coe-
VAULT_ADDR=
VAULT_TOKEN=
VAULT_MOUNT=secret
VAULT_PATH=rpa-coe

# ---------- Redis (cache / pub-sub / rate-limit store) ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Recommendation engine (Capacity Advisor) ----------
CAPACITY_UTILIZATION_WARNING=75       # % runner utilization => Warning
CAPACITY_UTILIZATION_CRITICAL=90      # % runner utilization => Critical
CAPACITY_LOOKAHEAD_DAYS=14
CAPACITY_MIN_SAMPLES=20               # min historical runs before advising

# ---------- Notifications ----------
NOTIFY_ENABLED=false
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
NOTIFY_SMTP_FROM=coe-alerts@bank.local
NOTIFY_SMTP_TLS=true
NOTIFY_SLACK_WEBHOOK=
NOTIFY_TEAMS_WEBHOOK=
NOTIFY_COOLDOWN_MINUTES=30

# ---------- Observability ----------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=rpa-coe-control-room
METRICS_ENABLED=true

# ---------- Runtime / serving behaviour ----------
DB_AUTO_BOOTSTRAP=true               # create tables + seed default tenant on startup
DB_SEED_DEMO=false                   # seed the demo dataset when the DB is empty (dev/demo)
SCHEDULER_ENABLED=true               # platform sync / capacity advisor / reaper / SLA snapshots
SCHEDULER_SYNC_MINUTES=10
SCHEDULER_CAPACITY_MINUTES=15
SCHEDULER_REAPER_MINUTES=30
REALTIME_ENABLED=true                # periodic KPI snapshots to SSE/WebSocket clients
REALTIME_TICK_SECONDS=15
SERVE_FRONTEND=true                  # serve the built React SPA from this process
FRONTEND_DIST=rpa-dashboard/dist
EXPOSE_DOCS=false                    # expose /docs + /openapi.json even in production

# ---------- Agent telemetry ----------
AGENT_STALE_SECONDS=180              # heartbeat age after which a runner is stale
PASSWORD_HISTORY_SIZE=5
ALERT_FAILURE_RATE_THRESHOLD=0.25
ALERT_FAILURE_MIN_RUNS=10
ALERT_REPEATED_FAILURE_THRESHOLD=3
COMMAND_ALLOWED_PROCESSES=
AGENT_COMMAND_HMAC_SECRET=
